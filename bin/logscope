#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const { computeSummary } = require(path.join(__dirname, '..', 'src', 'summary'));
const { computeTimeline } = require(path.join(__dirname, '..', 'src', 'timeline'));
const { grepLog } = require(path.join(__dirname, '..', 'src', 'grep'));
const { explainLog } = require(path.join(__dirname, '..', 'src', 'explain'));
const formatters = require(path.join(__dirname, '..', 'src', 'formatters'));

const VERSION = '1.0.0';

function showHelp() {
  console.log(`
logscope — quick log analysis CLI for operations teams

Usage:
  logscope summary <file> [--format {text,json,md}]
  logscope timeline <file> --bucket {1m|5m|15m|30m|1h} [--format {text,json,md}]
  logscope grep <file> [--level LEVEL] [--since DATETIME] [--until DATETIME] [--text TEXT] [--format {text,json,md}]
  logscope explain <file> [--endpoint URL] [--api-key KEY]
  logscope --help
  logscope --version

Commands:
  summary     Counts by log level, top 5 errors, first/last timestamp
  timeline    Error count per time bucket as ASCII bar chart
  grep        Filter lines by level, timestamp, or text
  explain     Analyze top errors with LLM for root-cause summary

Global options:
  --format    Output format: text (default), json, md
  --help, -h  Show this message
  --version   Show version

Examples:
  logscope summary app.log
  logscope timeline app.log --bucket 15m
  logscope grep app.log --level ERROR --since "2026-10-01 09:00"
  logscope summary app.log --format md
`);
}

function showVersion() {
  console.log(`logscope ${VERSION}`);
}

function parseArgs(args) {
  const parsed = {
    command: null,
    file: null,
    format: 'text',
    bucket: null,
    level: null,
    since: null,
    until: null,
    text: null,
    endpoint: null,
    apiKey: null
  };

  let i = 0;
  while (i < args.length) {
    const arg = args[i];

    if (arg === '--help' || arg === '-h') {
      showHelp();
      process.exit(0);
    }
    if (arg === '--version' || arg === '-v') {
      showVersion();
      process.exit(0);
    }
    if (arg === '--format') {
      parsed.format = args[++i];
    } else if (arg === '--bucket') {
      parsed.bucket = args[++i];
    } else if (arg === '--level') {
      parsed.level = args[++i];
    } else if (arg === '--since') {
      parsed.since = args[++i];
    } else if (arg === '--until') {
      parsed.until = args[++i];
    } else if (arg === '--text') {
      parsed.text = args[++i];
    } else if (arg === '--endpoint') {
      parsed.endpoint = args[++i];
    } else if (arg === '--api-key') {
      parsed.apiKey = args[++i];
    } else if (!parsed.command) {
      parsed.command = arg;
    } else if (!parsed.file) {
      parsed.file = arg;
    }

    i++;
  }

  return parsed;
}

async function main() {
  const args = process.argv.slice(2);

  if (args.length === 0) {
    showHelp();
    process.exit(2);
  }

  const parsed = parseArgs(args);
  const { command, file, format } = parsed;

  try {
    if (!command) {
      showHelp();
      process.exit(2);
    }

    if (!file) {
      throw new Error(`Missing file argument for command: ${command}`);
    }

    // Check file exists
    if (!fs.existsSync(file)) {
      console.error(`Error: File not found: ${file}`);
      process.exit(1);
    }

    if (format !== 'text' && format !== 'json' && format !== 'md') {
      throw new Error(`Invalid format: ${format}. Use: text, json, md`);
    }

    let result;

    if (command === 'summary') {
      result = await computeSummary(file);
      const formatter = formatters.summary[format];
      if (format === 'md') {
        const msg = await formatter(result, 'summary');
        console.log(msg);
      } else {
        console.log(formatter(result));
      }
    } else if (command === 'timeline') {
      if (!parsed.bucket) {
        throw new Error('--bucket is required for timeline command');
      }
      result = await computeTimeline(file, parsed.bucket);
      const formatter = formatters.timeline[format];
      if (format === 'md') {
        const msg = await formatter(result, 'timeline');
        console.log(msg);
      } else {
        console.log(formatter(result));
      }
    } else if (command === 'grep') {
      const filters = {
        level: parsed.level,
        since: parsed.since,
        until: parsed.until,
        text: parsed.text
      };
      result = await grepLog(file, filters);
      const formatter = formatters.grep[format];
      if (format === 'md') {
        const msg = await formatter(result, 'grep');
        console.log(msg);
      } else {
        console.log(formatter(result));
      }
    } else if (command === 'explain') {
      const explanation = await explainLog(file, parsed.endpoint, parsed.apiKey);
      console.log('\n' + '='.repeat(50));
      console.log('  ROOT CAUSE ANALYSIS');
      console.log('='.repeat(50) + '\n');
      console.log(explanation);
      console.log('\n' + '='.repeat(50) + '\n');
    } else {
      throw new Error(`Unknown command: ${command}`)
    }
  } catch (err) {
    console.error(`Error: ${err.message}`);
    process.exit(err.code === 'ENOENT' ? 1 : 3);
  }
}

main().catch(err => {
  console.error(`Fatal error: ${err.message}`);
  process.exit(3);
});
